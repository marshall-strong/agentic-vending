# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is gitignored. This file is committed, so it must never hold real secrets.

# --- DEX Bridge (the vending machine) -------------------------------------
# baseUrl from the Postman environment David emailed. Reachable only over
# Tailscale -- `tailscale status` must show aihub-pi before any of this works.
DEX_BASE_URL=http://aihub-pi:8000

# Our group key. Group B. Sent by David Robinson on 2026-09-10.
# Goes out as the X-API-Key header on every request except /health.
DEX_API_KEY=vend-b-xxxxxxxx

# Informational only -- records which access tier our key carries.
# The service also recognises an instructor tier that we do not have.
DEX_TIER=student

# --- Anthropic ------------------------------------------------------------
# Model spend is charged against the same $600 that buys inventory, so log
# usage on every call.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Institute shared log database ----------------------------------------
# Schema and credentials are not distributed yet (project brief, 3.5).
# Placeholders so the interface exists before the real thing arrives.
SHARED_LOG_URL=
SHARED_LOG_KEY=
