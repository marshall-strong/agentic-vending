# Copy this file to .env and fill in the real values.
#   cp .env.example .env
# .env is gitignored. This file is committed, so it must never hold real secrets.

# --- DEX Bridge (the vending machine) -------------------------------------
# Base URL of the bridge. Reachable only over Tailscale -- confirm the tailnet
# is up before running anything that talks to the machine:
#   tailscale status
DEX_BASE_URL=

# Our group API key. Distributed by course staff -- ask a teammate if you do
# not have it. Sent as the X-API-Key header on every request except /health.
DEX_API_KEY=

# Informational only -- records which access tier our key carries.
DEX_TIER=student

# --- Our database (Postgres 17) --------------------------------------------
# Local development runs Postgres in Docker (`docker compose up -d db`), which
# reads the password below. Pick any password for local use; the Azure database
# will have its own. DATABASE_URL is what the code connects with.
VENDING_DB_PASSWORD=
DATABASE_URL=postgresql://vending:<password>@127.0.0.1:55432/vending

# --- Anthropic ------------------------------------------------------------
# Model spend comes out of the same project budget that buys inventory, so log
# usage on every call.
ANTHROPIC_API_KEY=

# --- Institute shared log database ----------------------------------------
# Schema and credentials are not distributed yet. Placeholders so the
# interface exists before the real thing arrives.
SHARED_LOG_URL=
SHARED_LOG_KEY=
